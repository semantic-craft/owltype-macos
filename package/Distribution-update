<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="1"
    xmlns:owl="https://responsay.com/owltype/release-cohort">
    <title>猫头鹰 Owltype @VERSION@</title>
    <owl:releaseCohort>@COHORT_ID@</owl:releaseCohort>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion-update.html" mime-type="text/html"/>
    <pkg-ref id="im.owltype.inputmethod.Owltype"/>
    <options customize="never" require-scripts="false" rootVolumeOnly="true"/>
    <choices-outline>
        <line choice="default">
            <line choice="im.owltype.inputmethod.Owltype"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="im.owltype.inputmethod.Owltype" visible="false">
        <pkg-ref id="im.owltype.inputmethod.Owltype"/>
    </choice>
    <!-- UPDATE pkg (Owltype-update.pkg, the Sparkle enclosure): same Owltype-component.pkg as the
         first-install Owltype.pkg, but NO onConclusion="RequireLogout" — updates must not force a
         logout. The shared postinstall detects the update case
         (Owltype process alive = already enabled), switches the input source out to ABC before the
         kill, replaces files in place, relaunches the new binary (IMKServer endpoint re-publish),
         and schedules a one-shot login-session job that restores the selection after PackageKit
         finishes registering the replaced bundle (selecting from inside postinstall races that
         final registration and gets bounced back to a bare keylayout) — zero TIS enable calls on
         the update path, so no second-enable ghost state. First installs keep using Owltype.pkg
         (Distribution, RequireLogout). -->
    <pkg-ref id="im.owltype.inputmethod.Owltype">Owltype-component.pkg</pkg-ref>
</installer-gui-script>
