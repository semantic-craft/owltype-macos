<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="1"
    xmlns:famo="https://responsay.com/famo/release-cohort">
    <title>法墨 Famo @VERSION@</title>
    <famo:releaseCohort>@COHORT_ID@</famo:releaseCohort>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion-update.html" mime-type="text/html"/>
    <pkg-ref id="im.famo.inputmethod.Famo"/>
    <options customize="never" require-scripts="false" rootVolumeOnly="true"/>
    <choices-outline>
        <line choice="default">
            <line choice="im.famo.inputmethod.Famo"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="im.famo.inputmethod.Famo" visible="false">
        <pkg-ref id="im.famo.inputmethod.Famo"/>
    </choice>
    <!-- UPDATE pkg (Famo-update.pkg, the Sparkle enclosure): same Famo-component.pkg as the
         first-install Famo.pkg, but NO onConclusion="RequireLogout" — updates must not force a
         logout. The shared postinstall detects the update case
         (Famo process alive = already enabled), switches the input source out to ABC before the
         kill, replaces files in place, relaunches the new binary (IMKServer endpoint re-publish),
         and schedules a one-shot login-session job that restores the selection after PackageKit
         finishes registering the replaced bundle (selecting from inside postinstall races that
         final registration and gets bounced back to a bare keylayout) — zero TIS enable calls on
         the update path, so no second-enable ghost state. First installs keep using Famo.pkg
         (Distribution, RequireLogout). -->
    <pkg-ref id="im.famo.inputmethod.Famo">Famo-component.pkg</pkg-ref>
</installer-gui-script>
