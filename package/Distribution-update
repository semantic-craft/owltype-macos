<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="1"
    xmlns:owl="https://responsay.com/owltype/release-cohort">
    <title>猫头鹰 Owltype @VERSION@</title>
    <owl:releaseCohort>@COHORT_ID@</owl:releaseCohort>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion-update.html" mime-type="text/html"/>
    <pkg-ref id="im.owltype.inputmethod.Owltype"/>
    <options customize="never" require-scripts="false" rootVolumeOnly="true"/>
    <choices-outline>
        <line choice="default">
            <line choice="im.owltype.inputmethod.Owltype"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="im.owltype.inputmethod.Owltype" visible="false">
        <pkg-ref id="im.owltype.inputmethod.Owltype"/>
    </choice>
    <!-- Staged payload; atomic file commit followed by user-session activation. -->
    <pkg-ref id="im.owltype.inputmethod.Owltype">Owltype-component.pkg</pkg-ref>
</installer-gui-script>
