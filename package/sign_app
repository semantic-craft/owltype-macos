#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DEV_ID="${1:?missing Developer ID}"
RELEASE_OUTPUT_ROOT="${2:?missing release output root}"
NOTARY_PROFILE="${3:?missing notary profile}"

python3 "$ROOT/scripts/release-cohort-state.py" seal \
  "$RELEASE_OUTPUT_ROOT" app "$DEV_ID" "$NOTARY_PROFILE"
