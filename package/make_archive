#!/usr/bin/env bash
#
# make_archive — 生成真正的 Sparkle 自动更新 appcast（Squirrel 同款机制，载荷改用更新专用 pkg）。
# Sparkle 自动更新载荷 = 签名+公证的裸 .pkg：Sparkle 1.26+/2.x 按 `.pkg` 扩展名走 guided package
# installer（SUGuidedPackageInstaller）。<enclosure> 显式声明 sparkle:installationType="package"，
# 并指向 responsay.com 对象存储中按 build version 固定的 Owltype-update.pkg 链接
#（Distribution-update，无 RequireLogout），并带与 SUPublicEDKey 配对的 EdDSA 签名和长度。
# PackageKit 只写暂存目录；postinstall 调共享文件交换与用户会话自检。
# DMG 首装使用 OwltypeInstaller.app，另提供 Owltype.pkg。
# 当前仍由 Sparkle guided package installer 调包；仅下载接管及真实入口验收尚未完成。
# 安装机制及验收边界见 docs/operations/installation.md。

set -euo pipefail

cd "$(dirname "$0")"
# shellcheck source=package/common.sh
source common.sh

RELEASE_OUTPUT_ROOT="${RELEASE_OUTPUT_ROOT:-${PROJECT_ROOT}/build}"
COHORT_STATE="$PROJECT_ROOT/scripts/release-cohort-state.py"
python3 "$COHORT_STATE" appcast-ready "$RELEASE_OUTPUT_ROOT"
cohort_id="$(python3 "$COHORT_STATE" id "$RELEASE_OUTPUT_ROOT")"

# app_version = CFBundleVersion (build, e.g. 1.1.2) → Sparkle sparkle:version comparison ONLY.
# marketing_version = CFBundleShortVersionString (e.g. 1.1) → user-facing pkg name / title /
# download URL / appcast display (sparkle:shortVersionString). Keep them separate: a
# sparkle:version of 1.1 would read as OLDER than an installed 1.1.2 and suppress the update.
app_version="$(get_app_version)"
marketing_version="$(get_marketing_version)"
pub_date=$(date -R)

# Sparkle 固定到当前 CFBundleVersion 对应的不可变对象，不依赖仓库可见性或 latest 别名。
download_url="$(python3 "${PROJECT_ROOT}/scripts/owl_distribution.py" asset-url \
    "${app_version}" Owltype-update.pkg)"

# enclosure 需要已签名(+公证+staple)的 package/Owltype-update.pkg 存在（由 `make package` 产出）。缺它
# 就大声失败，绝不退化成 enclosure-less 的 information-only appcast（那是要还原掉的反模式）。
PKG="${PROJECT_ROOT}/package/Owltype-update.pkg"
if [ ! -f "${PKG}" ]; then
    echo >&2 "ERROR: 缺少 ${PKG}（先跑 make package）。appcast 的 <enclosure> 需要它来生成 edSignature/length。"
    exit 1
fi

# sign_update（Sparkle 工具）默认使用 Owltype 专属钥匙串 account。2.0.1 的一次性
# 过渡发布必须显式传 SPARKLE_ED25519_ACCOUNT=ed25519，并同时给 cohort 设置旧公钥；
# 之后任何未显式配置的发布都只会使用新身份的钥匙。
# 无凭据的机械发布链可显式提供一次性私钥文件；一旦提供就只用该文件，失效时绝不退回钥匙串。
# 输出形如：  sparkle:edSignature="…" length="…"
# 用 awk 解析两段属性塞进 <enclosure>（Squirrel make_archive 同款解析）。
cohort_file="${RELEASE_OUTPUT_ROOT:-${PROJECT_ROOT}/build}/release/OWLTYPE-RELEASE-COHORT.json"
sparkle_mode="$(python3 - "$cohort_file" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as handle:
    print(json.load(handle).get("sparkleFeedMode", ""))
PY
)"
if [[ "$sparkle_mode" != "bridge" && "$sparkle_mode" != "successor" ]]; then
    echo >&2 "ERROR: release cohort has no valid Sparkle feed mode"
    exit 1
fi
if [[ -n "${SPARKLE_ED25519_PRIVATE_KEY_FILE:-}" ]]; then
    sparkle_private_key="${SPARKLE_ED25519_PRIVATE_KEY_FILE}"
    if [[ ! -f "$sparkle_private_key" || ! -r "$sparkle_private_key" ]]; then
        echo >&2 "ERROR: SPARKLE_ED25519_PRIVATE_KEY_FILE must name a readable regular file"
        exit 1
    fi
    edSignature="$(./sign_update --ed-key-file "$sparkle_private_key" -p "${PKG}")"
    length="$(stat -f '%z' "${PKG}")"
else
    if [[ "$sparkle_mode" == "bridge" ]]; then
        sparkle_account="${SPARKLE_ED25519_ACCOUNT:-}"
        if [[ "$sparkle_account" != "ed25519" ]]; then
            echo >&2 "ERROR: 2.0.1 bridge requires explicit SPARKLE_ED25519_ACCOUNT=ed25519"
            exit 1
        fi
    else
        sparkle_account="${SPARKLE_ED25519_ACCOUNT:-owltype-ed25519}"
        if [[ "$sparkle_account" != "owltype-ed25519" ]]; then
            echo >&2 "ERROR: successor releases must use SPARKLE_ED25519_ACCOUNT=owltype-ed25519"
            exit 1
        fi
    fi
    signature="$(./sign_update --account "$sparkle_account" "${PKG}")"
    edSignature="$(echo "${signature}" | awk -F'"' '{print $2}')"
    length="$(echo "${signature}" | awk -F'"' '{print $4}')"
fi
if [ -z "${edSignature}" ] || [ -z "${length}" ]; then
    echo >&2 "ERROR: sign_update 没产出 edSignature/length"
    exit 1
fi
update_package_sha256="$(shasum -a 256 "${PKG}" | awk '{print $1}')"

write_appcast() {
    local appcast_file="$1"
    local title="$2"
    local description="$3"
    local link="$4"
    local enclosure_url="$5"
    cat > "${appcast_file}" << EOF
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0"
     xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle"
     xmlns:owl="https://responsay.com/owltype/release-cohort">
  <channel>
    <title>${title}</title>
    <link>${link}</link>
    <description>${description}</description>
    <language>zh</language>
    <item>
      <title>Owltype ${marketing_version}</title>
      <sparkle:version>${app_version}</sparkle:version>
      <sparkle:shortVersionString>${marketing_version}</sparkle:shortVersionString>
      <owl:releaseCohort>${cohort_id}</owl:releaseCohort>
      <owl:updatePackageSha256>${update_package_sha256}</owl:updatePackageSha256>
      <sparkle:minimumSystemVersion>14.0.0</sparkle:minimumSystemVersion>
      <pubDate>${pub_date}</pubDate>
      <sparkle:releaseNotesLink>${link}</sparkle:releaseNotesLink>
      <enclosure url="${enclosure_url}"
                 sparkle:version="${app_version}"
                 sparkle:shortVersionString="${marketing_version}"
                 sparkle:installationType="package"
                 sparkle:edSignature="${edSignature}"
                 length="${length}"
                 type="application/octet-stream"/>
    </item>
  </channel>
</rss>
EOF

    ls -l "${appcast_file}"
}

write_appcast 'appcast.xml' '法墨输入法更新频道' '法墨输入法 Appcast：Sparkle 自动下载签名+公证的 Owltype-update.pkg，并在 macOS 授权后安装（无需注销）。' 'https://responsay.com/owltype/' "${download_url}"
write_appcast 'testing-appcast.xml' '法墨输入法测试频道' '法墨输入法测试版 Appcast：Sparkle 自动下载签名+公证的 Owltype-update.pkg，并在 macOS 授权后安装（无需注销）。' 'https://responsay.com/owltype/' "${download_url}"
# 本地测试频道：enclosure 指向本地 package/Owltype-update.pkg（同一签名），便于离线验证下载/安装流程。
write_appcast 'debug-appcast.xml' '法墨输入法本地测试' '法墨输入法 Appcast 本地测试：enclosure 指向本地 package/Owltype-update.pkg。' "file://${PROJECT_ROOT}/package/debug-appcast.xml" "file://${PROJECT_ROOT}/package/Owltype-update.pkg"

python3 "$COHORT_STATE" register-output "$RELEASE_OUTPUT_ROOT" appcast \
    "$PROJECT_ROOT/package/appcast.xml"
