#! /bin/bash
# encoding: utf-8
#
# make_dmg — 组「新用户首装」DMG。主入口 = FamoInstaller.app（GUI 安装器，微信法首装免注销，
# task 07-02-famo-first-install-no-logout 复活），内嵌 **已 staple 的** Famo.app；另含：
#   - 卸载法墨.command   双击卸载，调同目录的 uninstall-famo.sh（严格白名单）。
#   - uninstall-famo.sh  白名单卸载脚本本体（与 .command 同目录打包，供其调用）。
# Famo.pkg 不再进 DMG，但继续由 `make package` 构建发布（备用/企业直装链，仍 RequireLogout）；
# Sparkle 自动更新仍走 Famo-update.pkg（本脚本零接触）。
#
# 用法:  bash package/make_dmg [DERIVED_DATA_PATH]   (默认 build)
# 前置:  build/Build/Products/Release/Famo.app 已构建 + 签名 + 公证 + staple
#        （`make dmg` 依赖 `package`，其链上的 notarized-app 产出它）。
# 签名:  仅在环境变量 DEV_ID 在位时签名 + 公证 + staple（与 Makefile 的 ifdef DEV_ID 一致；公开仓不硬
#        编码任何身份/TeamID）。DEV_ID 未设 → 跳过签名/公证，仍组出未签名 DMG（便于本地机械验证）。
#        ⚠️ 定律 6：未公证 DMG 带 quarantine 会被 App Translocation，安装器找不到内嵌 Famo.app——
#        本地机械验证请直接跑构建产物 FamoInstaller.app，别跑未公证 DMG。

set -e

cd "$(dirname "$0")"
source common.sh

DERIVED_DATA_PATH="${1:-build}"

marketing_version="$(get_marketing_version)"
build_version="$(get_app_version)"
VOLNAME="法墨输入法"

FAMO_APP="${PROJECT_ROOT}/${DERIVED_DATA_PATH}/Build/Products/Release/Famo.app"
INSTALLER_DIR="${PROJECT_ROOT}/installer"
INSTALLER_APP="${INSTALLER_DIR}/build/Build/Products/Release/FamoInstaller.app"
UNINSTALL_CMD="${PROJECT_ROOT}/package/卸载法墨.command"               # 双击卸载入口
UNINSTALL_SH="${PROJECT_ROOT}/scripts/uninstall-famo.sh"              # 白名单卸载脚本本体

DMG_STABLE="${PROJECT_ROOT}/package/Famo.dmg"                          # 稳定名（latest 永久链）
DMG_VERSIONED="${PROJECT_ROOT}/package/Famo-${marketing_version}.dmg"  # 版本归档名

# --- 前置：已构建 + 签名 + staple 的 Famo.app + 卸载脚本 -----------------------
if [ ! -d "${FAMO_APP}" ]; then
    echo >&2 "ERROR: 缺少已构建的 Famo.app: ${FAMO_APP}（先跑 make package / make notarized-app）"
    exit 1
fi
if [ ! -f "${UNINSTALL_CMD}" ]; then
    echo >&2 "ERROR: 缺少 ${UNINSTALL_CMD}"
    exit 1
fi
if [ ! -f "${UNINSTALL_SH}" ]; then
    echo >&2 "ERROR: 缺少 ${UNINSTALL_SH}"
    exit 1
fi

# --- 1) 构建 FamoInstaller.app（始终关签名；版本随 Famo 打戳）--------------------
# installer 工程用 automatic 签名 + 空 team，xcodebuild 阶段一律 CODE_SIGNING_ALLOWED=NO；
# DEV_ID 在位时下面用 codesign --force 显式重签（避免 automatic 签名要 DEVELOPMENT_TEAM）。
# 构建产物在 installer/build/，与主 build/ 分离——不污染 make_package 的 staging（坑 13 防线不动）。
echo "==> 构建 FamoInstaller.app（${marketing_version} / ${build_version}）"
(
    cd "${INSTALLER_DIR}"
    xcodegen generate
    xcodebuild -project FamoInstaller.xcodeproj -scheme FamoInstaller \
        -configuration Release -derivedDataPath build \
        MARKETING_VERSION="${marketing_version}" \
        CURRENT_PROJECT_VERSION="${build_version}" \
        CODE_SIGNING_ALLOWED=NO build
)

if [ ! -d "${INSTALLER_APP}" ]; then
    echo >&2 "ERROR: 没生成 FamoInstaller.app: ${INSTALLER_APP}"
    exit 1
fi

# --- 2) 内嵌已 staple 的 Famo.app ------------------------------------------
# **不要 re-sign** 这个内嵌的 Famo.app——保留它已公证 + staple 的签名。Installer.swift 在
# Contents/Library/Famo.app 找它（Apple 约定的嵌套代码位置，不放 Resources，规避公证拒绝）。
echo "==> 内嵌 Famo.app → FamoInstaller.app/Contents/Library"
EMBED_DIR="${INSTALLER_APP}/Contents/Library"
mkdir -p "${EMBED_DIR}"
rm -rf "${EMBED_DIR}/Famo.app"
cp -R "${FAMO_APP}" "${EMBED_DIR}/Famo.app"

# --- 3) 签外层 installer（仅 ifdef DEV_ID；不要 --deep，避免重签内嵌 Famo.app）-----
# hardened runtime 已在 project.yml 打开（ENABLE_HARDENED_RUNTIME），这里补 --options runtime
# 与主工程 sign_app 的公证要求对齐；无独立公证——内嵌代码随 DMG 公证覆盖 + DMG staple（1.3.16 形态）。
if [ -n "${DEV_ID:-}" ]; then
    echo "==> 签名 FamoInstaller.app（Developer ID Application: ${DEV_ID}）"
    codesign --force --options runtime --timestamp \
        --sign "Developer ID Application: ${DEV_ID}" "${INSTALLER_APP}"
    codesign --verify --strict --verbose=2 "${INSTALLER_APP}"
else
    echo "==> [跳过签名] DEV_ID 未设：FamoInstaller.app 不签名（仅本地机械验证）"
fi

# --- 4) 组 DMG 容器（先组稳定名，便于后续 sign/notarize/staple；版本名是最终产物的副本）---------
echo "==> 组 DMG 容器（UDZO）：FamoInstaller.app + 卸载法墨.command + uninstall-famo.sh"
STAGING="$(mktemp -d)"
trap 'rm -rf "${STAGING}"' EXIT
cp -R "${INSTALLER_APP}" "${STAGING}/FamoInstaller.app"
cp "${UNINSTALL_CMD}" "${STAGING}/卸载法墨.command"
cp "${UNINSTALL_SH}" "${STAGING}/uninstall-famo.sh"
chmod +x "${STAGING}/卸载法墨.command" "${STAGING}/uninstall-famo.sh"
rm -f "${DMG_STABLE}"
hdiutil create -volname "${VOLNAME}" -srcfolder "${STAGING}" -ov -format UDZO "${DMG_STABLE}"

# --- 5) 签 DMG（ifdef DEV_ID）---------------------------------------------
if [ -n "${DEV_ID:-}" ]; then
    echo "==> 签名 DMG"
    codesign --force --sign "Developer ID Application: ${DEV_ID}" --timestamp "${DMG_STABLE}"
fi

# --- 6) 公证 + staple DMG（ifdef DEV_ID）---------------------------------
if [ -n "${DEV_ID:-}" ]; then
    echo "==> 公证 DMG（notarytool --wait）"
    # Apple notary 服务偶发请求超时；重试几次再放弃（同 Makefile 里 app/pkg 的处理，坑 11）。
    #
    # 重试耗尽必须**就地失败**，不能往下走。`&& break` 让失败不触发 `set -e`，而 1.5.13 出包时
    # 三次全败（公证凭据中途消失，报 `No Keychain password item found`）之后这里照样去 staple 了
    # ——staple 当然也失败，于是终端上留下的是 `CloudKit … Record not found` + `Error 65` 这种
    # 与真因无关的报错，真正那句「凭据没了」被埋在二十行之前。构建是挂了（退出码非零），但把人
    # 引向了错误的方向：会去查 CloudKit / 网络，而不是去重建凭据。
    notarized=0
    for i in 1 2 3; do
        if xcrun notarytool submit "${DMG_STABLE}" \
            --keychain-profile "${NOTARY_PROFILE:?set NOTARY_PROFILE to your notarytool keychain-profile name}" \
            --wait; then
            notarized=1; break
        fi
        echo "[famo] notary(dmg) 超时/失败，重试 ${i}/3（20s）…"; sleep 20
    done
    if [ "${notarized}" -ne 1 ]; then
        echo >&2 "ERROR: DMG 公证三次均失败，停在这一步（不再尝试 staple）。"
        echo >&2 "       上面 notarytool 的最后一条输出就是真因。若它是"
        echo >&2 "       'No Keychain password item found for profile: ${NOTARY_PROFILE}'，"
        echo >&2 "       说明公证凭据条目消失了（已复发两次：1.5.5 / 1.5.13）。恢复："
        echo >&2 "       xcrun notarytool store-credentials ${NOTARY_PROFILE} --apple-id <apple id> --team-id <team id>"
        echo >&2 "       随后 'make dmg' 单独补这一步即可，app/pkg 的公证不受影响。"
        exit 1
    fi
    xcrun stapler staple "${DMG_STABLE}"
fi

# --- 7) Gatekeeper 校验（ifdef DEV_ID）----------------------------------
# NOTE: spctl 对 DMG 用 `-t open`；必须带 -vv 才打印 'accepted'（不带 -v 静默，macOS 26 尤甚）。
if [ -n "${DEV_ID:-}" ]; then
    echo "==> Gatekeeper 校验"
    spctl -a -t open --context context:primary-signature -vv "${DMG_STABLE}" 2>&1 | grep -q 'accepted' \
        || { echo >&2 "ERROR: ${DMG_STABLE} 未通过 Gatekeeper（签名/公证有问题）"; exit 1; }
fi

# --- 8) 落版本归档名（最终产物的副本，与已签名/公证/staple 状态一致）-----------
cp "${DMG_STABLE}" "${DMG_VERSIONED}"

echo "完成：$(basename "${DMG_STABLE}")（稳定名）+ $(basename "${DMG_VERSIONED}")"
ls -lh "${DMG_STABLE}" "${DMG_VERSIONED}"
if [ -z "${DEV_ID:-}" ]; then
    echo "NOTE: 未签名/未公证 DMG（DEV_ID 未设，仅机械验证）。生产发布请带 DEV_ID/NOTARY_PROFILE 重跑。"
fi
