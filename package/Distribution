<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="1">
    <title>法墨 Famo @VERSION@</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <pkg-ref id="im.famo.inputmethod.Famo"/>
    <options customize="never" require-scripts="false" rootVolumeOnly="true"/>
    <choices-outline>
        <line choice="default">
            <line choice="im.famo.inputmethod.Famo"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="im.famo.inputmethod.Famo" visible="false">
        <pkg-ref id="im.famo.inputmethod.Famo"/>
    </choice>
    <!-- onConclusion="RequireLogout" (Squirrel model): FIRST-INSTALL pkg only (Famo.pkg, shipped in
         the DMG). After install, loginwindow re-reads the input-source list so 法墨 is GUARANTEED to
         appear in the input menu — the user-requested "菜单一定出现" guarantee. postinstall does
         register/enable/select; the logout closes the loop. Sparkle auto-updates no longer serve this
         pkg: they serve Famo-update.pkg (built from Distribution-update, NO onConclusion) — updates
         install in place without a logout, postinstall handles the smooth switch-out/kill/relaunch/
         switch-back sequence (fcitx5 model). BundleOverwriteAction=upgrade (Famo-component.plist)
         only governs in-place file overwrite (the app + bundled Sparkle.framework swap without a
         reinstall); it does NOT suppress this pkg's logout. -->
    <pkg-ref id="im.famo.inputmethod.Famo" onConclusion="RequireLogout">Famo-component.pkg</pkg-ref>
</installer-gui-script>
