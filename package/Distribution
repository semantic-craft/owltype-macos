<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="1"
    xmlns:owl="https://responsay.com/owltype/release-cohort">
    <title>猫头鹰 Owltype @VERSION@</title>
    <owl:releaseCohort>@COHORT_ID@</owl:releaseCohort>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <pkg-ref id="im.owltype.inputmethod.Owltype"/>
    <options customize="never" require-scripts="false" rootVolumeOnly="true"/>
    <choices-outline>
        <line choice="default">
            <line choice="im.owltype.inputmethod.Owltype"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="im.owltype.inputmethod.Owltype" visible="false">
        <pkg-ref id="im.owltype.inputmethod.Owltype"/>
    </choice>
    <!-- onConclusion="RequireLogout" (Squirrel model): FIRST-INSTALL pkg only (Owltype.pkg, shipped in
         the DMG). After install, loginwindow re-reads the input-source list so 猫头鹰 is GUARANTEED to
         appear in the input menu — the user-requested "菜单一定出现" guarantee. postinstall does
         register/enable/select; the logout closes the loop. Sparkle auto-updates no longer serve this
         pkg: they serve Owltype-update.pkg (built from Distribution-update, NO onConclusion) — updates
         install in place without a logout, postinstall handles the smooth switch-out/kill/relaunch/
         switch-back sequence (fcitx5 model). BundleOverwriteAction=upgrade (Owltype-component.plist)
         only governs in-place file overwrite (the app + bundled Sparkle.framework swap without a
         reinstall); it does NOT suppress this pkg's logout. -->
    <pkg-ref id="im.owltype.inputmethod.Owltype" onConclusion="RequireLogout">Owltype-component.pkg</pkg-ref>
</installer-gui-script>
