#!/bin/bash
# PackageKit owns an inert archive, never an App bundle. No receipt-boundary jobs.
# Privileged phase changes files only; TIS and process actions run as the captured console user.
set -euo pipefail
[[ $EUID == 0 && ${3:-/} == / ]] || exit 1
installer_state_dir='/private/var/db/im.owltype.inputmethod.Owltype-installer'
markers="${installer_state_dir}/markers"
staging='/Library/Input Methods/.Owltype.pkg-staging'
archive="$staging/Owltype.app.zip"
live_app='/Library/Input Methods/Owltype.app'
for path in "$installer_state_dir" "$markers" "$staging"; do
  [[ ! -L "$path" && -d "$path" ]] || exit 1
done
login_uid=$(/bin/cat "$markers/login-uid")
login_user=$(/bin/cat "$markers/login-user")
kind=$(/bin/cat "$markers/install-kind")
source_before=$(/bin/cat "$markers/selected-source")
[[ "$login_uid" == "$(/usr/bin/stat -f%u /dev/console)" && "$login_uid" -ge 501 ]] || exit 1
[[ "$kind" == first || "$kind" == update ]] || exit 1
[[ -f "$archive" && ! -L "$archive" ]] || exit 1
# A fresh root-only directory prevents the console user from replacing extracted files. It sits
# outside Input Methods, where a retained App would be registered as a second input method.
# Preserve it on failure; remove it on successful file commit, before PackageKit finalization.
unpack="$(/usr/bin/mktemp -d "${installer_state_dir}/unpack.XXXXXXXX")"
/bin/chmod 700 "$unpack"
/usr/bin/ditto -x -k "$archive" "$unpack"
staged_app="$unpack/Owltype.app"
[[ -d "$staged_app" && ! -L "$staged_app" ]] || exit 1
/usr/bin/codesign --verify --deep --strict -R='=anchor apple generic and identifier "im.owltype.inputmethod.Owltype" and certificate 1[field.1.2.840.113635.100.6.2.6] /* exists */ and certificate leaf[field.1.2.840.113635.100.6.1.13] /* exists */ and certificate leaf[subject.OU] = "LQAVR62TK2"' "$staged_app"
version=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleVersion' "$staged_app/Contents/Info.plist")
"$staged_app/Contents/MacOS/Owltype" --commit-install "$staged_app"
/bin/rm -rf "$unpack"
# The archive is consumed; leave nothing in Input Methods for the next preinstall to keep.
/bin/rm -f "$archive"
/bin/rmdir "$staging" 2>/dev/null || true
# All session actions (including first-install registration) use the user's Aqua bootstrap.
/bin/launchctl asuser "$login_uid" /usr/bin/sudo -u "$login_user" \
  "$live_app/Contents/MacOS/Owltype" --finish-install "$kind" "$source_before" "$version"
echo 'Owltype: files committed and user-session self-check passed; no logout requested.'
