#!/bin/bash
# PackageKit delivers a complete staged App, never live Contents. No receipt-boundary jobs.
# Privileged phase changes files only; TIS and process actions run as the captured console user.
set -euo pipefail
[[ $EUID == 0 && ${3:-/} == / ]] || exit 1
installer_state_dir='/private/var/db/im.owltype.inputmethod.Owltype-installer'
markers="${installer_state_dir}/markers"
staged_app='/Library/Input Methods/.Owltype.pkg-staging/Owltype.app'
live_app='/Library/Input Methods/Owltype.app'
for path in "$installer_state_dir" "$markers" "$staged_app"; do
  [[ ! -L "$path" && -d "$path" ]] || exit 1
done
login_uid=$(/bin/cat "$markers/login-uid")
login_user=$(/bin/cat "$markers/login-user")
kind=$(/bin/cat "$markers/install-kind")
source_before=$(/bin/cat "$markers/selected-source")
[[ "$login_uid" == "$(/usr/bin/stat -f%u /dev/console)" && "$login_uid" -ge 501 ]] || exit 1
[[ "$kind" == first || "$kind" == update ]] || exit 1
/usr/bin/codesign --verify --deep --strict "$staged_app"
version=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleVersion' "$staged_app/Contents/Info.plist")
"$staged_app/Contents/MacOS/Owltype" --commit-install "$staged_app"
# All session actions (including first-install registration) use the user's Aqua bootstrap.
/bin/launchctl asuser "$login_uid" /usr/bin/sudo -u "$login_user" \
  "$live_app/Contents/MacOS/Owltype" --finish-install "$kind" "$source_before" "$version"
echo 'Owltype: files committed and user-session self-check passed; no logout requested.'
