#!/bin/bash
# Capture the console session before payload extraction. Payload only writes a staging tree.
set -euo pipefail
[[ $EUID == 0 && ${3:-/} == / ]] || { echo 'Owltype: install on the boot volume as root.' >&2; exit 1; }
installer_state_dir='/private/var/db/im.owltype.inputmethod.Owltype-installer'
markers="${installer_state_dir}/markers"
input_root='/Library/Input Methods'
staging="${input_root}/.Owltype.pkg-staging"
for path in "$installer_state_dir" "$markers" "$input_root" "$staging"; do
  [[ ! -L "$path" ]] || { echo "Owltype: refusing symlink $path" >&2; exit 1; }
done
/usr/bin/install -d -o root -g wheel -m 711 "$installer_state_dir"
/usr/bin/install -d -o root -g wheel -m 700 "$markers"
/usr/bin/install -d -o root -g staff -m 755 "$input_root"
login_uid=$(/usr/bin/stat -f%u /dev/console)
login_user=$(/usr/bin/stat -f%Su /dev/console)
[[ "$login_uid" -ge 501 && "$login_user" != loginwindow ]] || { echo 'Owltype: active GUI user required.' >&2; exit 1; }
kind=first
source_before=''
if [[ -e "$input_root/Owltype.app" ]]; then
  kind=update
  source_before=$(/bin/launchctl asuser "$login_uid" /usr/bin/sudo -u "$login_user" \
    "$input_root/Owltype.app/Contents/MacOS/Owltype" --current-input-source)
  [[ -n "$source_before" ]] || { echo 'Owltype: cannot capture current input source.' >&2; exit 1; }
fi
# Preserve a previous incomplete payload; never overwrite it or the live Contents in place.
if [[ -e "$staging" ]]; then
  /bin/mv "$staging" "$input_root/.Owltype.abandoned-$(/usr/bin/uuidgen)"
fi
/usr/bin/install -d -o root -g staff -m 755 "$staging"
umask 077
printf '%s\n' "$kind" > "$markers/install-kind"
printf '%s\n' "$source_before" > "$markers/selected-source"
printf '%s\n' "$login_uid" > "$markers/login-uid"
printf '%s\n' "$login_user" > "$markers/login-user"
