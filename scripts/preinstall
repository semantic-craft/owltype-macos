#!/bin/bash
# Capture the console session before payload extraction. Payload only writes a staging tree.
set -euo pipefail
[[ $EUID == 0 && ${3:-/} == / ]] || { echo 'Owltype: install on the boot volume as root.' >&2; exit 1; }
installer_state_dir='/private/var/db/im.owltype.inputmethod.Owltype-installer'
markers="${installer_state_dir}/markers"
input_root='/Library/Input Methods'
staging="${input_root}/.Owltype.pkg-staging"
for path in "$installer_state_dir" "$markers" "$input_root" "$staging"; do
  [[ ! -L "$path" ]] || { echo "Owltype: refusing symlink $path" >&2; exit 1; }
done
/usr/bin/install -d -o root -g wheel -m 711 "$installer_state_dir"
/usr/bin/install -d -o root -g wheel -m 700 "$markers"
/usr/bin/install -d -o root -g staff -m 755 "$input_root"
login_uid=$(/usr/bin/stat -f%u /dev/console)
login_user=$(/usr/bin/stat -f%Su /dev/console)
[[ "$login_uid" -ge 501 && "$login_user" != loginwindow ]] || { echo 'Owltype: active GUI user required.' >&2; exit 1; }
kind=first
source_before=''
# An App without Info.plist is incomplete; --commit-install sets it aside and installs fresh.
if [[ ! -L "$input_root/Owltype.app" && -f "$input_root/Owltype.app/Contents/Info.plist" ]] \
   && /usr/bin/codesign --verify --deep --strict "$input_root/Owltype.app" >/dev/null 2>&1; then
  kind=update
  source_before=$(/bin/launchctl asuser "$login_uid" /usr/bin/sudo -u "$login_user" \
    "$input_root/Owltype.app/Contents/MacOS/Owltype" --current-input-source)
  [[ -n "$source_before" ]] || { echo 'Owltype: cannot capture current input source.' >&2; exit 1; }
fi
# LaunchServices and the input menu register bundles under Input Methods, hidden or not, so a
# leftover copy shows up as a second 法墨输入法. Install intermediates now live under
# $installer_state_dir; an earlier payload or older installer's leftovers are kept for
# inspection there, unregistered, never deleted or reused.
lsregister='/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister'
retained="${installer_state_dir}/retained"
/usr/bin/install -d -o root -g wheel -m 700 "$retained"
unregister() {
  "$lsregister" -u "$1" >/dev/null 2>&1 || true
  /bin/launchctl asuser "$login_uid" /usr/bin/sudo -u "$login_user" "$lsregister" -u "$1" >/dev/null 2>&1 || true
}
retain() {
  local entry=$1 bundle target
  unregister "$entry"
  if [[ -d "$entry" && ! -L "$entry" ]]; then
    while IFS= read -r bundle; do unregister "$bundle"; done \
      < <(/usr/bin/find "$entry" -mindepth 1 -maxdepth 2 -name '*.app' -print)
  fi
  target="$retained/${entry##*/}"
  [[ ! -e "$target" && ! -L "$target" ]] || target="$target-$(/usr/bin/uuidgen)"
  /bin/mv "$entry" "$target"
}
# A staging tree holding only the archive is an earlier package's inert payload; anything else
# is unknown and kept. Never overwrite it or the live Contents in place.
if [[ -e "$staging" ]]; then
  if [[ -z "$(/usr/bin/find "$staging" -mindepth 1 ! \( -path "$staging/Owltype.app.zip" -type f \) -print -quit)" ]]; then
    /bin/rm -rf "$staging"
  else
    retain "$staging"
  fi
fi
# An older installer whose --commit-install is still running may be mid-commit: leave its
# directories alone. Without that process its lock is stale (killed or power loss) and is
# retained with the rest, so it cannot block this cleanup forever.
if [[ ! -e "$input_root/.Owltype.install-lock" ]] || ! /usr/bin/pgrep -f -- ' --commit-install ' >/dev/null; then
  for entry in "$input_root"/.Owltype.*; do
    [[ -e "$entry" || -L "$entry" ]] || continue
    retain "$entry"
  done
fi
/usr/bin/install -d -o root -g staff -m 755 "$staging"
umask 077
printf '%s\n' "$kind" > "$markers/install-kind"
printf '%s\n' "$source_before" > "$markers/selected-source"
printf '%s\n' "$login_uid" > "$markers/login-uid"
printf '%s\n' "$login_user" > "$markers/login-user"
