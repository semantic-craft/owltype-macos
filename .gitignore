package/Owltype*.dmg
package/Owltype*.zip
# 发 Release 时给 DMG/pkg 生成的校验和清单。不 ignore 会以未跟踪文件留在树里，卡住**下一版**
# `make source-archive` 的洁净门（要求连未跟踪文件都干净）——1.5.8 与 1.5.14 各被咬过一次。
package/Owltype*.sha256
# 同一道洁净门：release 链里的 python 脚本 import scripts/famo_bundle.py，跑一次就落一个
# __pycache__/，紧接着的 make source-archive 会被自己上一步弄脏的树卡住。
scripts/__pycache__/
package/sign/*.pem
package/test-*
package/generate_keys
package/sign_update
package/*.xml
*~
.*.swp
.DS_Store
data/famo-rime/

# 增量 B 端上语义重排 (task 06-20-famo-bge-small-coreml-rerank): offline build artifacts produced
# by tools/bge_small_to_coreml.py. Large (mirrors the wanxiang .gram / data/plum pattern); injected
# at build time into the app bundle Resources and NEVER committed. Absent → heuristic fallback.
*.mlpackage
Resources/bge-small-zh.mlpackage
Resources/vocab.txt

# OwltypeInstaller 独立首装安装器（安装器专题 06-27 P2）: xcodegen 从 installer/project.yml
# 重生成 .xcodeproj，构建产物落 installer/build/（build/ 已被上面通配覆盖，此处显式列出更清晰）。
# project.yml + Sources/ 才是源，须提交；生成的 .xcodeproj 与 build/ 不提交。
installer/OwltypeInstaller.xcodeproj/
installer/build/

# Local credentials, signing material and AI-agent state must never enter the
# public repository. Example env files remain allowed for documentation.
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.pem
*.p12
*.p8
*.key
*.keystore
*.jks
*.mobileprovision
*.log
.claude/settings.local.json
.codex/
.cursor/
.wrangler/
.windsurf/
.continue/
.aider*
