Owltype.xcodeproj/*.mode1v3
Owltype.xcodeproj/*.pbxuser
Owltype.xcodeproj/project.xcworkspace/
Owltype.xcodeproj/xcuserdata/
build/
build.log
*.profraw
Frameworks/*
bin/*
lib/*
data/opencc/
